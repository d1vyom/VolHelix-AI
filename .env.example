# ═══════════════════════════════════════════
# VolHelix AI — Environment Configuration Template
# ═══════════════════════════════════════════

# ── Binance Spot Testnet (Paper Trading) ──
# Get keys from: https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_USE_TESTNET=true

# Separate USD-M Futures demo credentials; execution always uses demo-fapi.
# One-way positions, single-asset USDT margin and 1x symbol leverage required.
# Configure in Binance demo; VolHelix never changes these account settings.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# ── LLM: Google Gemini (agent workflow; not required for public streams) ──
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash

# ── Trading Configuration ──
TRADING_INTERVAL_MINUTES=5
# Legacy configuration value; does not seed account funds or a PnL baseline.
INITIAL_CAPITAL=10000
WATCHED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
MAX_POSITION_PCT=0.025
MAX_DAILY_DRAWDOWN=0.03

# ── Server Ports ──
API_PORT=8000
DASHBOARD_PORT=3000
LOG_LEVEL=INFO
 
# ── Order Flow Engine ──
FLOW_ENABLED=true
FLOW_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
FLOW_WS_BASE_URL=wss://stream.binance.com:9443
FLOW_DEPTH_LEVELS=20
FLOW_USE_DIFF_DEPTH=true
FLOW_FOOTPRINT_INTERVALS=1m,5m,15m
FLOW_IMBALANCE_RATIO=3.0
FLOW_STACKED_IMBALANCE_MIN=3
FLOW_WHALE_NOTIONAL_USD=100000
FLOW_BROADCAST_HZ=4
FLOW_CONFLUENCE_ENABLED=false
FLOW_PERSIST_BARS=false


# Explicit frontend origins; wildcard credentialed CORS is unsupported.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Docker build-time browser Socket.IO URL; rebuild frontend after changing it.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
# REST BACKEND_URL defaults to http://127.0.0.1:8000 locally.
# Compose sets BACKEND_URL=http://backend:8000 at build and runtime.
